rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 방명록 컬렉션 규칙
    match /guestbook/{document} {
      // 모든 사람이 읽기 가능
      allow read: if true;
      
      // 방명록 작성 규칙 (필수 필드 검증)
      allow create: if request.resource.data.keys().hasAll(['name', 'message', 'timestamp', 'createdAt', 'sessionId']) &&
        request.resource.data.name is string &&
        request.resource.data.message is string &&
        request.resource.data.sessionId is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 50 &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 200;
      
      // 작성자 본인과 관리자만 삭제 가능
      // 1. 작성자 본인 (sessionId로 식별) - 로그인 없이 가능
      // 2. 관리자 (특정 이메일로 식별) - 로그인 필요
      allow delete: if resource.data.sessionId != null || 
        (request.auth != null && request.auth.token.email in ['isooeuni@gmail.com', 'admin@wedding.com']);
      
      // 수정 금지
      allow update: if false;
    }
  }
}
